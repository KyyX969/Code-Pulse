# ===========================================
# CodePulse Environment Configuration
# ===========================================
# Copy this file to .env and fill in credentials for live integrations.
# Without external keys, CodePulse runs seamlessly in Local Persistence + Simulator Mode.

# Server & App URLs
PORT=4000
APP_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000

# Security (Generate a 32+ char random string in production)
SESSION_SECRET=codepulse-dev-session-secret-change-in-prod
TOKEN_ENCRYPTION_KEY=codepulse-dev-32byte-aes256-key!!

# GitHub OAuth & Webhooks (F-01, F-03, F-04)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback
GITHUB_WEBHOOK_SECRET=

# Vercel OAuth & Deployment API (F-01, F-05)
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
VERCEL_REDIRECT_URI=http://localhost:4000/api/auth/vercel/callback

# Supabase PostgreSQL & Realtime (Optional - falls back to local JSON store if empty)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# WebRTC STUN / TURN (F-06)
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

